# Server
PORT=5001

# Admin passcode for dashboard access
ADMIN_PASSCODE=

# Allowed frontend origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL Database URL
# Local example: postgresql://user:password@localhost:5432/portfolio
# Render example: postgresql://user:password@host/dbname
DATABASE_URL=

# Cloudinary (optional - leave empty to use local storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
